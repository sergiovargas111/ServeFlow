# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Used for account deletion. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site (used in auth email/OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: a throwaway Supabase project for RLS integration tests (never production)
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=

# Server-only. Powers the AI coach (/api/coach). Never expose to the browser.
# Default provider: the Claude API.
ANTHROPIC_API_KEY=
# Or Claude in Amazon Bedrock: set COACH_PROVIDER=bedrock, a region, and AWS
# credentials (access keys below, an AWS profile, or AWS_BEARER_TOKEN_BEDROCK).
# Enable model access for Claude Opus 5.5 in the Bedrock console first.
# COACH_PROVIDER=bedrock
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Later phases
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
